# Copiez ce fichier en ".env" et remplissez vos vraies valeurs.
# Ne jamais commiter le fichier .env reel dans un depot public.

PORT=3000

# Compte Gmail qui ENVOIE la notification (peut etre iqraexpertise@gmail.com
# lui-meme, ou un compte technique dedie). Necessite un "mot de passe
# d'application" Google (pas le mot de passe normal du compte) :
# https://myaccount.google.com/apppasswords
SMTP_USER=votre_compte_envoi@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx

# Adresse qui RECOIT la notification de nouveau dossier
EXPERT_EMAIL=iqraexpertise@gmail.com

# Cle secrete de signature des sessions (obligatoire en production).
# Generez une valeur aleatoire, par exemple avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=remplacez_moi_par_une_valeur_aleatoire_longue

# Identifiant et mot de passe du compte expert cree automatiquement au premier
# demarrage. Si EXPERT_PASSWORD n'est pas defini, un mot de passe aleatoire est
# genere et affiche UNE SEULE FOIS dans les logs du serveur au demarrage.
EXPERT_USERNAME=expert
EXPERT_PASSWORD=

# Mettre a "production" une fois deploye derriere HTTPS (rend le cookie de
# session "secure"). Laisser vide en developpement local (http://localhost).
NODE_ENV=
